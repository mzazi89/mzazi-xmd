# ─────────────────────────────────────────────────────────────────────────────
# MZAZI XMD — environment
#
# Copy to `.env` and fill in. Never commit the real file.
# These are NOT shared with the QUARTZ bot's deployment: each bot has its own
# process and its own secrets. Only the values marked "shared" must match.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Shared Neon PostgreSQL — the same database the website uses.
# Used for pairing, WhatsApp sessions, subscriptions and telemetry.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# This bot's key for GET /api/xmd-command.
# Set the matching value on the website as XMD_BOT_API_KEY (or in admin →
# Settings as `xmd_bot_api_key`). Without it the website returns command
# METADATA ONLY — no executable code — and every command will be skipped.
XMD_BOT_API_KEY=""

# This bot's OWN Telegram bot token from @BotFather.
# Do NOT reuse QUARTZ's token: two processes cannot poll the same Telegram bot,
# and they will fight over every update.
TELEGRAM_BOT_TOKEN=""

# ── Command hosting ──────────────────────────────────────────────────────────

# Where the command registry is served from. This bot uses its own path, which
# is what keeps it independent from QUARTZ XD (/api/bot-command).
REMOTE_API_URL="https://mzazi.shop/api/xmd-command"

# This bot serves exactly ONE profile. Do not add "quartz" here — QUARTZ runs
# separately, and two processes claiming the same profile id will overwrite each
# other's bot_status heartbeat.
BOT_PROFILES='[{"id":"xmd","name":"MZAZI XMD"}]'

# ── Payments (must match the website) ────────────────────────────────────────

PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# ── Site API (needed by download commands) ───────────────────────────────────

MZAZI_SITE_URL="https://mzazi.shop"
MZAZI_API_KEY=""

# ── Optional ─────────────────────────────────────────────────────────────────

# A WhatsApp channel for the bot to auto-follow. Leave unset to follow none.
XMD_NEWSLETTER_JID=""

# Local webhook server — set only if you use it.
WEBHOOK_PORT="3000"
WEBHOOK_URL=""

# Reported to the dashboard as this bot's public IP. Empty = auto-detect.
BOT_IP=""

# ── Console logging ──────────────────────────────────────────────────────────

# What the incoming-message card may print:
#   preview (default)  first LOG_PREVIEW_CHARS characters of the text/caption
#   full               the whole message
#   off                metadata only — sender, chat, kind; no words
# The words belong to real people and this console is readable by whoever runs
# the server. Set "off" if that matters for your deployment.
LOG_MESSAGE_CONTENT="preview"
LOG_PREVIEW_CHARS="180"

# card (default) = boxed block per message, compact = one line per message.
LOG_STYLE="card"

# Timestamps in the message cards. Defaults to Africa/Nairobi.
LOG_TIMEZONE="Africa/Nairobi"

# Card width in terminal cells. Defaults to 44 — the Pterodactyl console pane is
# about 45 wide on a phone, and a box one cell wider wraps and tears its border.
# Raise it if you watch the console on a desktop terminal.
LOG_WIDTH="44"

# Commands that must be typed with the prefix even when the session runs in
# "no prefix" mode (customPrefix = ""), because they address the whole group.
PREFIX_ONLY_COMMANDS="tagall,tagall2,hidetagall,mention,callall,tagnotadmin"

# Repeats of the same console error are collapsed: first one prints with its
# stack, the rest are counted and summarised once the burst stops.
LOG_ERROR_WINDOW_MS="12000"
